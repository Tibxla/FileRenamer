QMainWindow, QProgressDialog, QMessageBox, QFileDialog {
    background-color: #2b2b2b;
    color: #ffffff;
}

QLabel {
    color: #ffffff;
}

QLabel#renamePreview {
    color: #bfbfbf;
}

QLabel#renamePreview[previewError="true"] {
    color: #ffaaa4;
}

QPushButton, QLineEdit, QComboBox {
    color: #ffffff;
    border: 1px solid #606060;
    border-radius: 0;
}

QPushButton, QLineEdit {
    min-height: 16px;
    padding: 5px 8px;
}

QPushButton {
    background-color: #4a4a4a;
}

QPushButton:hover {
    background-color: #5a5a5a;
}

QPushButton:pressed {
    background-color: #3a3a3a;
}

QPushButton:disabled {
    background-color: #2b2b2b;
    color: #bfbfbf;
}

QPushButton#renameButton {
    background-color: #315f8d;
    border-color: #315f8d;
    color: #ffffff;
    font-weight: bold;
}

QPushButton#renameButton:hover {
    background-color: #386a9b;
}

QPushButton#renameButton:pressed {
    background-color: #274f78;
}

QLineEdit, QComboBox, QMessageBox QTextEdit {
    background-color: #3c3c3c;
    color: #ffffff;
    selection-background-color: #315f8d;
    selection-color: #ffffff;
    placeholder-text-color: #bfbfbf;
}

QLineEdit:focus, QComboBox:focus, QPushButton:focus, QPushButton#renameButton:focus {
    border-color: #8bbcf3;
}

QComboBox {
    min-height: 26px;
    padding-right: 23px;
}

QComboBox QLineEdit {
    border: none;
    min-height: 0;
    padding: 0;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 23px;
    border-left: 1px solid #606060;
    background-color: #333333;
}

QComboBox::down-arrow {
    image: url(:/dropdown-arrow.xpm);
    width: 9px;
    height: 5px;
}

QComboBox QAbstractItemView, QFileDialog QAbstractItemView {
    background-color: #3c3c3c;
    color: #ffffff;
    border: 1px solid #606060;
    selection-background-color: #315f8d;
    selection-color: #ffffff;
    outline: 0;
}

QComboBox QAbstractItemView::item {
    min-height: 22px;
}

QProgressBar {
    background-color: #3c3c3c;
    color: #ffffff;
    border: 1px solid #606060;
    text-align: center;
}
